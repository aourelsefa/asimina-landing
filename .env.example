# Public site URL (canonical URLs, Open Graph, sitemap, JSON-LD).
# Set this in production (e.g. Vercel → Environment Variables).
NEXT_PUBLIC_SITE_URL=https://asiminahabipi.com

# Sanity (Studio at /studio)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-06-04
# Editor token for seed script only — do not expose publicly
SANITY_API_WRITE_TOKEN=
# Secret for Sanity webhook → POST /api/revalidate?secret=...
SANITY_REVALIDATE_SECRET=
